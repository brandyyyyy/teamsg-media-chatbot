# ==============================================================================
# TeamSG Media Chatbot - Environment Configuration Template
# Copy this file to .env and fill in real values before setting MOCK_MODE=false.
# All variables are validated at boot by config/environment.js (Zod).
# ==============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Mock / Test Mode -------------------------------------------------------
# When true, ALL 4 ingestion sources are served by src/ingestion/mockAdapter.js
# so the whole system (sync, chat, media packages) can be exercised end-to-end
# with zero external credentials. Set to false to hit live Google Sheets / disk.
MOCK_MODE=true
# Deterministic seed label used by scripts/seed.js when generating fixtures.
MOCK_SEED=2026

# --- AI Provider ---------------------------------------------------------------
# /api/chat can run on OpenAI or Google Gemini. 'auto' picks OpenAI if
# OPENAI_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else chat
# responds with a clear "not configured" message (all REST data endpoints
# keep working either way). Set 'openai' or 'gemini' to force one backend.
AI_PROVIDER=auto

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Web Search Fallback -----------------------------------------------------
# When true, the AI engine is allowed to call the web_search tool as a last
# resort and MUST prefix that portion of its answer with the required
# external-source warning banner. See src/services/aiEngine.js webSearchTool()
# for where to plug in a real provider (Bing/Serper/Tavily/etc).
WEB_SEARCH_ENABLED=false

# --- Source 2 & 3: Google Sheets (required when MOCK_MODE=false) ------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key. If stored as a single line, keep the \n escapes -
# environment.js converts them to real newlines automatically.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID_CONTINGENT=
GOOGLE_SHEET_ID_SCHEDULE=
GOOGLE_CONTINGENT_RANGE=Contingent!A1:Z1000
GOOGLE_SCHEDULE_RANGE=Schedule!A1:Z1000

# --- Source 1 & 4: Local Files ------------------------------------------------
# Historical results spreadsheet (Source 1). This exact filename does not
# need to exist - if it's missing, the app uses whichever .xlsx/.xls file
# is most recently modified in this same directory, so periodically
# replacing this file with a freshly-dated export (e.g.
# consolidated_games_150726.xlsx) just works. This path is still the
# default target file written by `npm run seed`.
HISTORICAL_EXCEL_PATH=./data/historical/past_results.xlsx
# Folder of per-sport narrative files (Source 4), e.g. swimming.md, athletics.md
HIGHLIGHTS_DIR=./data/highlights
# Scratch folder for any transient uploads
UPLOAD_DIR=./data/uploads

# --- Sync & Uploads ------------------------------------------------------------
SYNC_INTERVAL_MS=300000
MAX_UPLOAD_SIZE_MB=10
